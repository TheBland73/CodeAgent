# 行尾统一：仓库内一律使用 LF，检出时由 Git 自动转换。
# 这样 Windows 与 Linux/macOS 协作者之间不会出现"整个文件都变了"的假 diff。
* text=auto eol=lf

# 文本文件显式声明
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.log   text eol=lf

# Windows 专有脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不做行尾转换，也不参与 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary

# 让 GitHub 的语言统计不被文档淹没（可选）
*.md    linguist-documentation
